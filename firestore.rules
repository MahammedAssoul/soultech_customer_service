rules_version = '2';

// Soultech Vending — Firestore Security Rules
//
// Admins are identified via the `admins` collection: a document with id
// equal to the user's auth uid. Admin UIDs must be added by the developer
// (via the seed script or Firebase console).
//
// Customers (anonymous auth users) can:
//   - read active machines/products + product requests + requested products + votes count
//   - create issues and product requests
//   - create/delete their own votes
// Admins can read/write everything.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function signedIn() {
      return request.auth != null;
    }

    // ---------- admins ----------
    match /admins/{uid} {
      // Admins can list other admins and grant/revoke admin access.
      allow read: if isAdmin();
      // An admin can add another admin (create) or remove one (delete);
      // they cannot modify an existing admin record (update).
      allow create: if isAdmin() && request.resource.data.uid == uid;
      allow update: if false;
      allow delete: if isAdmin() && uid != request.auth.uid;
    }

    // ---------- machines ----------
    match /machines/{machineId} {
      allow read: if signedIn();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---------- products ----------
    match /products/{productId} {
      allow read: if signedIn();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---------- issues ----------
    match /issues/{issueId} {
      allow read: if signedIn();
      // Customers create issues; admins can too.
      allow create: if signedIn() && request.resource.data.status == 'new' &&
        request.resource.data.referenceNumber is string &&
        request.resource.data.machineId is string &&
        request.resource.data.issueType is string;
      // Only admins update issue status/photos/etc.
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---------- productRequests (legacy tracking records) ----------
    match /productRequests/{requestId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.status == 'new' &&
        request.resource.data.referenceNumber is string;
      // Only admins update status.
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---------- requestedProducts (voting list) ----------
    match /requestedProducts/{requestedId} {
      allow read: if signedIn();
      // Customers can create a requested product (a new voteable suggestion).
      allow create: if signedIn() &&
        request.resource.data.voteCount == 0 &&
        request.resource.data.status == 'new' &&
        request.resource.data.productName is string &&
        request.resource.data.machineId is string;
      // Admins can change anything.
      allow update: if isAdmin();
      // Customers can ONLY adjust the denormalized voteCount by +/- 1 when
      // they create/delete their own vote. This lets the vote transaction
      // (increment/decrement) run without letting customers touch status,
      // adminNote, photoUrl or any other field.
      allow update: if signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['voteCount', 'updatedAt']) &&
        (request.resource.data.voteCount == resource.data.voteCount + 1 ||
         request.resource.data.voteCount == resource.data.voteCount - 1);
      allow delete: if isAdmin();
    }

    // ---------- productRequestVotes ----------
    match /productRequestVotes/{voteId} {
      allow read: if signedIn();
      // A customer can create/delete only their own vote. The vote id is
      // `${productRequestId}_${voterId}` so duplicates are structurally
      // impossible.
      allow create: if signedIn() &&
        request.resource.data.voterId == request.auth.uid;
      allow delete: if signedIn() &&
        resource.data.voterId == request.auth.uid;
      allow update: if false;
    }

    // ---------- machineVisits (analytics) ----------
    match /machineVisits/{visitId} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}